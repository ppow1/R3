{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"r3a.notification-module-config.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_id","contract_version","dsn_env","source_token_env","steward_token_env","steward_principal_env","presentation_timezone","source_ids","subscriptions"],
  "properties":{
    "contract_id":{"const":"r3a.notification-module-config"},
    "contract_version":{"const":"1.0.0"},
    "dsn_env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
    "source_token_env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
    "steward_token_env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
    "steward_principal_env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
    "presentation_timezone":{"type":"string","minLength":1},
    "source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "subscriptions":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["category","event_type","urgency","requires_action","recipient"],
      "properties":{
        "category":{"enum":["resident_objective_completed","resident_objective_blocked","independent_verification_failed","steward_approval_required","service_or_capability_unavailable","resident_delegation_completed","service_state_changed"]},
        "event_type":{"type":"string","minLength":1},
        "urgency":{"enum":["low","normal","high","critical"]},
        "requires_action":{"type":"boolean"},
        "recipient":{"type":"object","additionalProperties":false,"required":["kind","office_role"],"properties":{"kind":{"enum":["resident","office","steward"]},"office_role":{"type":"string","minLength":1}}},
        "filter":{"type":"object","additionalProperties":false,"properties":{
          "activity_type":{"type":"string","minLength":1},
          "evidence_equals":{"type":"object"}
        }}
      }
    }}
  }
}
