{
  "schema_id": "r3a.steward-access.config.v1",
  "schema_version": 1,
  "enabled": true,
  "identity_mode": "independent",
  "session_dsn_env": "R3A_STEWARD_DATABASE_DSN",
  "identity": {
    "provider": "r3a.native",
    "issuer": "r3a-steward"
  },
  "session": {
    "cookie_name": "r3a_steward_session",
    "lifetime_seconds": 28800,
    "connect_timeout_seconds": 3,
    "secure_cookie": true,
    "allowed_origins": ["https://192.168.1.155:8311"]
  },
  "cme": {
    "control_socket": "/run/r3a/cme-control.sock",
    "request_timeout_seconds": 20,
    "health_stale_after_seconds": 30
  },
  "remote_transport": {
    "state": "unavailable",
    "public_exposure": false
  }
}
