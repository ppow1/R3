{
  "schema_version": 1,
  "plugin_id": "r3a.reasoning-inference",
  "plugin_version": "1.0.0",
  "artifact_ref": "plugin.py",
  "artifact_sha256": "0f9e0eb7b2db46a6e389624e18ee9375732da82f0ede526e691dced9ccef1234",
  "configuration_schema": {
    "schema_id": "r3a.reasoning-inference.config.v1",
    "type": "object",
    "required": [
      "temperature"
    ],
    "additionalProperties": false,
    "properties": {
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "api_key_env": {
        "type": "string",
        "pattern": "[A-Z][A-Z0-9_]*"
      }
    }
  },
  "operation": {
    "contract_id": "r3a.capability-operation.v1",
    "contract_version": "1.0.0",
    "operation_id": "reasoning.model.invoke",
    "operation_revision": "1.0.0",
    "provider": {
      "provider_id": "r3a.reasoning-inference",
      "provider_version": "1.0.0",
      "entrypoint": "r3a_plugins.reasoning_inference.plugin:create_provider",
      "artifact_sha256": "0f9e0eb7b2db46a6e389624e18ee9375732da82f0ede526e691dced9ccef1234"
    },
    "input_schema": {
      "type": "object",
      "required": [
        "messages"
      ],
      "additionalProperties": false,
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": [
        "role_id",
        "route_id",
        "provider",
        "model",
        "content",
        "provider_result_ref",
        "usage",
        "elapsed_ms",
        "finished_at"
      ],
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string"
        },
        "route_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "provider_result_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "object"
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "effect_class": "external_write",
    "caller_constraints": {
      "allowed_principals": [],
      "allowed_residents": [
        "resident.grace"
      ],
      "allowed_services": []
    },
    "target_scope_schema": {
      "type": "object",
      "required": [
        "role_id"
      ],
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required_grants": [
      "reasoning.model.invoke"
    ],
    "evidence": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "evidence_id",
            "request_ref",
            "request_sha256",
            "result_ref",
            "result_sha256",
            "role_id",
            "route_id",
            "provider",
            "model",
            "usage",
            "elapsed_ms",
            "observed_at"
          ],
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "request_ref": {
              "type": "string"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "result_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "role_id": {
              "type": "string"
            },
            "route_id": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "usage": {
              "type": "object"
            },
            "elapsed_ms": {
              "type": "number",
              "minimum": 0
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "verification_obligations": [
        "Preserve provider/model/route identity and request/result digest and usage."
      ]
    },
    "recovery": {
      "idempotency_required": true,
      "idempotency_scope": "invocation",
      "replay_safe": false,
      "reconciliation_operation_id": null
    },
    "execution": {
      "timeout_seconds": 180,
      "retry_disposition": "never"
    },
    "lifecycle": {
      "desired_state": "enabled"
    },
    "resident_tool": {
      "name": "Configured Reasoning Provider",
      "description": "Perform one authorized, budget-reserved model inference selected by CME for Grace's reasoning continuation."
    }
  },
  "provider": {
    "provider_id": "r3a.reasoning-inference",
    "provider_version": "1.0.0",
    "entrypoint": "r3a_plugins.reasoning_inference.plugin:create_provider",
    "artifact_sha256": "0f9e0eb7b2db46a6e389624e18ee9375732da82f0ede526e691dced9ccef1234"
  }
}
