{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "example.module-boilerplate.configuration.v1",
  "title": "Offline module boilerplate configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "settings"],
  "properties": {
    "schema_id": {"const": "example.module-boilerplate.configuration.v1"},
    "schema_version": {"const": 1},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_label": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    }
  }
}
