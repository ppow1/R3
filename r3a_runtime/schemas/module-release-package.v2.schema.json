{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.module-release-package.v2@2.0.0",
  "title": "R3A immutable process-module release package v2",
  "type": "object",
  "required": ["schema_id", "schema_version", "source", "module", "role", "launch_profile", "runtime_dependencies", "files"],
  "additionalProperties": false,
  "properties": {
    "schema_id": {"const": "r3a.module-release-package.v2"},
    "schema_version": {"const": "2.0.0"},
    "source": {
      "type": "object",
      "required": ["repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "module": {
      "type": "object",
      "required": ["module_id", "module_version", "owner", "manifest_contract", "entrypoint", "entrypoint_sha256"],
      "additionalProperties": false,
      "properties": {
        "module_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,159}$"},
        "module_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 160},
        "manifest_contract": {
          "type": "object",
          "required": ["contract_id", "contract_version"],
          "additionalProperties": false,
          "properties": {
            "contract_id": {"const": "r3a.module-manifest.v1"},
            "contract_version": {"enum": ["1.1.0", "1.2.0"]}
          }
        },
        "entrypoint": {"$ref": "#/$defs/dottedModule"},
        "entrypoint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "role": {
      "type": "object",
      "required": ["contract_id", "contract_version", "execution_contract_range"],
      "additionalProperties": false,
      "properties": {
        "contract_id": {"const": "r3a.resident.executor"},
        "contract_version": {"const": "1.0.0"},
        "execution_contract_range": {
          "type": "object",
          "required": ["contract_id", "major", "min_minor", "max_minor"],
          "additionalProperties": false,
          "properties": {
            "contract_id": {"const": "r3a.resident.execution-profile"},
            "major": {"const": 1},
            "min_minor": {"type": "integer", "minimum": 0},
            "max_minor": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "launch_profile": {
      "type": "object",
      "required": ["binding", "protocol_id", "protocol_major", "protocol_min_minor", "protocol_max_minor", "import_root", "entrypoint", "argv_template"],
      "additionalProperties": false,
      "properties": {
        "binding": {"const": "process"},
        "protocol_id": {"const": "r3a.module-jsonl-worker.v1"},
        "protocol_major": {"type": "integer", "minimum": 1},
        "protocol_min_minor": {"type": "integer", "minimum": 0},
        "protocol_max_minor": {"type": "integer", "minimum": 0},
        "import_root": {"$ref": "#/$defs/relativePath"},
        "entrypoint": {"$ref": "#/$defs/dottedModule"},
        "argv_template": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "runtime_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"},
    "dottedModule": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"}
  }
}
