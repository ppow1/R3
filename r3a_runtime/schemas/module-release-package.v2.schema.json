{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.module-release-package.v2@2.0.0",
  "title": "R3A Module Release Package v2",
  "type": "object",
  "required": ["schema_id", "schema_version", "module_id", "module_version", "module_kind", "metadata_ref", "metadata_sha256", "artifact_digest", "files", "process_binding"],
  "additionalProperties": false,
  "properties": {
    "schema_id": {"const": "r3a.module-release-package.v2"},
    "schema_version": {"const": 2},
    "module_id": {"type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"},
    "module_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "module_kind": {"const": "resident_executor"},
    "metadata_ref": {"const": "MODULE_METADATA.json"},
    "metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "process_binding": {
      "type": "object",
      "required": ["contract_id", "contract_version", "process_kind", "protocol_id", "protocol_major", "protocol_min_minor", "protocol_max_minor", "runtime_id", "entrypoint", "arguments_template"],
      "additionalProperties": false,
      "properties": {
        "contract_id": {"const": "r3a.module-process-binding.v1"},
        "contract_version": {"const": "1.0.0"},
        "process_kind": {"const": "jsonl"},
        "protocol_id": {"const": "r3a.module.v1"},
        "protocol_major": {"type": "integer", "minimum": 1},
        "protocol_min_minor": {"type": "integer", "minimum": 0},
        "protocol_max_minor": {"type": "integer", "minimum": 0},
        "runtime_id": {"const": "python3"},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "arguments_template": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
