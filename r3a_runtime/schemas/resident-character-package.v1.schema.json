{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.resident.character-package.v1",
  "title": "Coordinator resident character integration package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "package_version", "integration_kind", "artifacts", "context_contract", "host_services", "execution_boundary", "sink_policy", "activation_gates"],
  "properties": {
    "package_id": {"type": "string", "const": "r3a.resident.character-architecture"},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "integration_kind": {"type": "string", "const": "coordinator-inference-context-hook"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "context_contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "version", "schema"], "properties": {"contract_id": {"type": "string", "const": "r3a.resident.approved-character-context"}, "version": {"type": "string", "const": "2.0.0"}, "schema": {"type": "string", "const": "r3a_runtime/schemas/approved-character-context.v2.schema.json"}}},
    "host_services": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "enum": ["authenticated_actor", "authoritative_hr_identity_resolver", "character_context_grant_checker", "versioned_dossier_repository", "sink_authorizer", "content_free_audit_sink"]}},
    "execution_boundary": {"type": "object", "additionalProperties": false, "required": ["fields", "source", "pin_policy"], "properties": {"fields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "enum": ["canonical_resident_id", "execution_kind", "execution_ref", "provider_id", "authenticated_principal_ref"]}}, "source": {"type": "string", "const": "coordinator-server-authenticated-execution-context"}, "pin_policy": {"type": "string", "const": "immutable-for-execution-boundary"}}},
    "sink_policy": {"type": "object", "additionalProperties": false, "required": ["inference", "memory", "communications", "diagnostics", "generic_capability_output"], "properties": {"inference": {"type": "string", "const": "authorized-context-only"}, "memory": {"type": "string", "const": "versioned-reference-only"}, "communications": {"type": "string", "const": "versioned-reference-only"}, "diagnostics": {"type": "string", "const": "content-free-metadata-only"}, "generic_capability_output": {"type": "string", "const": "forbidden-for-character-text"}}},
    "activation_gates": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["source-verified-hr-association", "current-directory-office-binding", "approved-active-character-revision", "runtime-host-injection", "sink-authorization"]}}
  }
}
