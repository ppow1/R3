{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.resident.identity-association.v1",
  "title": "R3A source-grounded resident identity association",
  "description": "A revisioned evidence projection joining existing HR, dossier, directory, credential, grant, and execution records. This is not an identity registry or authority source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "association_ref", "resident_id", "hr", "dossier", "directory", "credential_ref", "grant_refs", "runtime", "evidence_refs", "verified_at"],
  "properties": {
    "schema_id": {"const": "r3a.resident.identity-association", "type": "string"},
    "schema_version": {"const": 1, "type": "integer"},
    "association_ref": {"type": "string", "minLength": 1},
    "resident_id": {"type": "string", "pattern": "^r3:[a-z0-9_.:-]+$"},
    "hr": {
      "type": "object", "additionalProperties": false,
      "required": ["resident_id", "revision", "source_ref", "authority_principal", "principal_association_ref"],
      "properties": {
        "resident_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "authority_principal": {"type": "string", "pattern": "^resident:[A-Za-z0-9_.:-]+$"},
        "principal_association_ref": {"type": "string", "minLength": 1}
      }
    },
    "dossier": {
      "type": "object", "additionalProperties": false,
      "required": ["resident_id", "revision", "status"],
      "properties": {
        "resident_id": {"type": "string"},
        "revision": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "status": {"const": "active", "type": "string"}
      }
    },
    "directory": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_contract", "snapshot_sha256", "observed_at", "principal_id", "office_id", "office_role", "binding_revision"],
      "properties": {
        "source_id": {"const": "riverview_authority.directory", "type": "string"},
        "source_contract": {"const": "riverview-authority.directory.v1", "type": "string"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "principal_id": {"type": "string", "pattern": "^resident:[A-Za-z0-9_.:-]+$"},
        "office_id": {"type": "string", "minLength": 1},
        "office_role": {"type": "string", "minLength": 1},
        "binding_revision": {"type": "integer", "minimum": 1}
      }
    },
    "credential_ref": {"type": "string", "minLength": 1, "pattern": "^(credential|authority)://[^?#\\n]+$"},
    "grant_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_revision", "route_id"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_revision": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_at": {"type": "string", "format": "date-time"}
  }
}
