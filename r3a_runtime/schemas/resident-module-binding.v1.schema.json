{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.resident.module-binding.v1",
  "title": "R3A Resident Module Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "resident_id", "module_id", "module_version", "artifact_digest", "execution_contract_range", "binding_revision", "configuration_ref", "configuration_revision", "identity_association"],
  "properties": {
    "contract_id": {"const": "r3a.resident.module-binding"},
    "contract_version": {"const": "1.0.0"},
    "resident_id": {"type": "string", "pattern": "^resident:[A-Za-z0-9][A-Za-z0-9._-]{0,198}$"},
    "module_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "module_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_contract_range": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "major", "min_minor", "max_minor"],
      "properties": {
        "contract_id": {"const": "r3a.resident.execution"},
        "major": {"type": "integer", "minimum": 1},
        "min_minor": {"type": "integer", "minimum": 0},
        "max_minor": {"type": "integer", "minimum": 0}
      }
    },
    "binding_revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "configuration_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
    "configuration_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity_association": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "record_id", "record_revision"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 256},
        "record_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "record_revision": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
