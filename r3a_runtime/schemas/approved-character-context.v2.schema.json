{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.resident.approved-character-context.v2",
  "title": "Approved provider-neutral resident character context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "resident_id", "directory_resident_id",
    "identity_revision", "directory_binding_revision", "directory_snapshot_sha256",
    "directory_source_ref", "hr_source_ref", "hr_principal_association_ref", "office_id", "office_role",
    "execution_profile_id", "execution_profile_revision", "execution_profile_resident_id",
    "execution_route_id", "execution_profile_source_ref",
    "execution_kind", "execution_ref",
    "pin_ref", "provider_id", "dossier_revision", "dossier_sha256", "context_sha256",
    "activation_status", "classification_scope", "authorization_ref", "prompt_text",
    "prompt_sha256", "prompt_component_refs", "source_refs", "personality",
    "personality_sources", "authority_granted"
  ],
  "properties": {
    "contract_id": {"type": "string", "const": "r3a.resident.approved-character-context"},
    "contract_version": {"type": "string", "const": "2.0.0"},
    "resident_id": {"type": "string", "pattern": "^r3:.+"},
    "directory_resident_id": {"type": "string", "pattern": "^resident:.+"},
    "identity_revision": {"type": "string", "minLength": 1},
    "directory_binding_revision": {"type": "integer", "minimum": 1},
    "directory_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "directory_source_ref": {"type": "string", "minLength": 1},
    "hr_source_ref": {"type": "string", "minLength": 1},
    "hr_principal_association_ref": {"type": "string", "minLength": 1},
    "office_id": {"type": "string", "minLength": 1},
    "office_role": {"type": "string", "minLength": 1},
    "execution_profile_id": {"type": "string", "minLength": 1},
    "execution_profile_revision": {"type": "string", "minLength": 1},
    "execution_profile_resident_id": {"type": "string", "pattern": "^resident:.+"},
    "execution_route_id": {"type": "string", "minLength": 1},
    "execution_profile_source_ref": {"type": "string", "minLength": 1},
    "execution_kind": {"type": "string", "enum": ["inference_activity", "conversation_boundary"]},
    "execution_ref": {"type": "string", "minLength": 1},
    "pin_ref": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "dossier_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dossier_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activation_status": {"type": "string", "const": "active"},
    "classification_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["public", "institutional"]}},
    "authorization_ref": {"type": "string", "minLength": 1},
    "prompt_text": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_component_refs": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "personality": {"type": "object", "required": ["warmth", "humor", "formality", "assertiveness", "curiosity", "spontaneity", "empathy", "expressiveness", "professional_directness"], "properties": {"warmth": {"type": "integer", "minimum": 0, "maximum": 100}, "humor": {"type": "integer", "minimum": 0, "maximum": 100}, "formality": {"type": "integer", "minimum": 0, "maximum": 100}, "assertiveness": {"type": "integer", "minimum": 0, "maximum": 100}, "curiosity": {"type": "integer", "minimum": 0, "maximum": 100}, "spontaneity": {"type": "integer", "minimum": 0, "maximum": 100}, "empathy": {"type": "integer", "minimum": 0, "maximum": 100}, "expressiveness": {"type": "integer", "minimum": 0, "maximum": 100}, "professional_directness": {"type": "integer", "minimum": 0, "maximum": 100}}, "additionalProperties": false},
    "personality_sources": {"type": "object", "additionalProperties": {"type": "string"}},
    "authority_granted": {"type": "boolean", "const": false}
  }
}
