{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.activity-handler.action.v1",
  "title": "R3A Activity Handler Capability Action v1",
  "type": "object",
  "required": ["contract_id", "contract_version", "action_id", "operation_id", "operation_contract_version", "target", "input", "evidence_purpose", "durable_work"],
  "additionalProperties": false,
  "properties": {
    "contract_id": {"const": "r3a.activity-handler.action"},
    "contract_version": {"const": "1.0.0"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operation_contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "target": {"type": "object"},
    "input": {"type": "object"},
    "evidence_purpose": {"type": "string", "minLength": 1, "maxLength": 1024},
    "durable_work": {
      "type": ["object", "null"],
      "required": ["contract_id", "contract_version", "work_id", "record"],
      "additionalProperties": false,
      "properties": {
        "contract_id": {"const": "r3a.activity-handler.work-item"},
        "contract_version": {"const": "1.0.0"},
        "work_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "record": {"type": "object"}
      }
    }
  }
}
