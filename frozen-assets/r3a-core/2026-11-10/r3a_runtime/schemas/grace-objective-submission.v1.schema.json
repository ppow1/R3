{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3a.grace-objective-submission.v1",
  "title": "R3A Grace objective submission v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/accepted"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["contract", "contract_version", "objective", "acceptance_criteria", "idempotency_key"],
      "additionalProperties": false,
      "properties": {
        "contract": {"const": "r3a.grace-objective-submission.v1"},
        "contract_version": {"const": "1.0.0"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200}
      }
    },
    "accepted": {
      "type": "object",
      "required": ["contract", "contract_version", "activity_id", "state", "correlation_id"],
      "properties": {
        "contract": {"const": "r3a.grace-objective-submission.v1"},
        "contract_version": {"const": "1.0.0"},
        "activity_id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
